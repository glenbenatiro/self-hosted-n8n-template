# Copy this file to .env and modify the values for your setup.
# IMPORTANT: Dollar signs ($) in passwords must be escaped as $$.

# Database
# https://docs.n8n.io/hosting/configuration/environment-variables/database/
POSTGRES_DB=n8n_db
POSTGRES_USER=n8n_db_user
POSTGRES_PASSWORD=change_me

# n8n version (n8nio/n8n and the matching n8nio/runners image). Pin an exact release.
# update-n8n.sh moves this to the newest release on N8N_UPDATE_CHANNEL. https://github.com/n8n-io/n8n/releases
N8N_VERSION=2.42.7
# Update channel for update-n8n.sh: stable (for production) or beta (newest, may be unstable).
N8N_UPDATE_CHANNEL=stable
# Set to true to let update-n8n.sh also move to a new major version (for example 2.x to 3.x).
# Read the breaking changes first: https://docs.n8n.io/changelog/v30-breaking-changes/
N8N_AUTO_UPDATE_MAJOR=false
# How many database backups update-n8n.sh keeps, newest first, whatever their age.
N8N_UPDATE_KEEP_BACKUPS=7

# Deployment
# https://docs.n8n.io/hosting/configuration/environment-variables/deployment/
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_me_32_char_random_string
N8N_EDITOR_SUBDOMAIN=n8n
N8N_WEBHOOK_SUBDOMAIN=hooks-n8n
DOMAIN_NAME=example.com
N8N_PROTOCOL=https
N8N_PROXY_HOPS=1

# Queue mode
# https://docs.n8n.io/hosting/configuration/environment-variables/queue-mode/
REDIS_PASSWORD=change_me

# Task runners: shared secret between n8n and its runner containers.
# Generate with: openssl rand -hex 32
N8N_RUNNERS_AUTH_TOKEN=change_me

# Timezone and localization
# https://docs.n8n.io/hosting/configuration/environment-variables/timezone-localization/
GENERIC_TIMEZONE=Etc/UTC

# User management and 2FA (SMTP)
# https://docs.n8n.io/hosting/configuration/environment-variables/user-management-smtp-2fa/
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_PORT=465
N8N_SMTP_USER=your_email@gmail.com
N8N_SMTP_PASS=your_gmail_app_password
N8N_SMTP_SENDER=n8n.example.com
